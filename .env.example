# 应用配置
APP_NAME=SuperBizAgent
DEBUG=True
HOST=0.0.0.0
PORT=9900

# OpenRouter 配置 (https://openrouter.ai/keys 获取，替换为你的真实 Key)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 配置（对话/诊断主模型；默认 NVIDIA Nemotron 3.5 Lightning）
RAG_TOP_K=3

# Embedding / Rerank（本地运行，无需 API Key）
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_DEVICE=          # 留空自动：mps > cpu
# RERANK_ENABLED=True
# RERANK_MODEL=BAAI/bge-reranker-base

# 弱模型层（路由/改写等轻任务；默认 Nemotron 3 Nano 免费档）
# LLM_BACKUP_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp
