# 应用配置
APP_NAME=SuperBizAgent
DEBUG=True
HOST=0.0.0.0
PORT=9900

# OpenRouter 配置 (https://openrouter.ai/keys 获取，替换为你的真实 Key)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 配置（对话/诊断主模型；默认 NVIDIA Nemotron 3.5 Lightning）
RAG_TOP_K=3

# Embedding / Rerank（本地运行，无需 API Key）
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_DEVICE=          # 留空自动：mps > cpu
# RERANK_ENABLED=True
# RERANK_MODEL=BAAI/bge-reranker-base

# 弱模型层（路由/改写等轻任务；默认 Nemotron 3 Nano 免费档）
# LLM_BACKUP_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# 长期记忆（P2；四类记忆 + sqlite 存储 + 向量召回 + 情景→语义巩固）
# MEMORY_ENABLED=True                  # 总开关，False 时全部读写为无副作用空操作
# MEMORY_DB_PATH=data/memory.db        # sqlite 路径（WAL 模式，自动建目录）
# MEMORY_RECALL_K=5                    # 单次召回上限
# MEMORY_MIN_IMPORTANCE=0.2            # 召回的重要性下限
# MEMORY_DECAY_LAMBDA=0.05             # 新近度每日衰减率 λ
# MEMORY_WEIGHT_RELEVANCE=0.6          # 打分权重：相关性（+重要性+新近度 = 1）
# MEMORY_WEIGHT_IMPORTANCE=0.25
# MEMORY_WEIGHT_RECENCY=0.15
# MEMORY_CONSOLIDATE_THRESHOLD=0.85    # 情景→语义巩固的余弦相似度阈值
# MEMORY_CONSOLIDATE_ENABLED=True      # C3 定时巩固 worker 开关（手动端点不受限）
# MEMORY_CONSOLIDATE_INTERVAL_SECONDS=3600  # 巩固周期（秒，≥60）

# 上下文引擎（P2；token 预算替换硬编码条数截断）
# CONTEXT_TOKEN_BUDGET=6000            # 注入 LLM 的上下文总预算（近似估算）
# CONTEXT_HISTORY_BUDGET=2400          # ReAct 对话历史 token 预算

# 告警 webhook（C2；Alertmanager 兼容通道 POST /api/alerts/webhook）
# ALERT_WEBHOOK_TOKEN=                  # 可选共享密钥；非空时请求须带 X-Alert-Token 头
# ALERT_WEBHOOK_DEDUP_WINDOW_SECONDS=300  # firing 指纹去重窗口（秒，防重发重复诊断）
